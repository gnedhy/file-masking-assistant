FROM node:22-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
ENV VITE_OPERATIONS_ENABLED=true
RUN npm run build
FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY package*.json ./
RUN npm ci --omit=dev
COPY --from=build /app/dist ./dist
COPY src/operationLog.js src/operationReports.js src/operationSync.js ./src/
COPY worker ./worker
COPY server ./server
CMD ["node", "server/operations-index.mjs"]
