# Copy to .env.enterprise and replace every placeholder. Compose reads POSTGRES_PASSWORD from here too.
POSTGRES_PASSWORD=replace-with-a-long-random-password
# Public address users open, without a trailing slash. Must match the WeCom trusted domain.
PUBLIC_ORIGIN=https://file-mask.example.corp
WECOM_CORP_ID=ww0000000000000000
WECOM_AGENT_ID=1000002
COOKIE_SECURE=true
VAULT_KEY_VERSION=v1
