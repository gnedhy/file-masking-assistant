{
  "name": "file-masking-assistant",
  "version": "2.0.0-dev",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5174",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "start:enterprise": "node server/index.mjs",
    "test": "npm run test:unit && npm run test:validation && npm run build && npm run test:sites",
    "test:unit": "node --test tests/token-format.test.mjs tests/xlsx-core.test.mjs tests/xlsx-package.test.mjs tests/csv-core.test.mjs tests/text-core.test.mjs tests/multi-fixture-roundtrip.test.mjs tests/office-openxml.test.mjs tests/html-core.test.mjs tests/file-preflight.test.mjs tests/file-safety.test.mjs tests/enterprise-vault.test.mjs",
    "test:e2e": "playwright test",
    "generate:validation": "node scripts/generate-validation-assets.mjs tests/output/validation-assets",
    "generate:performance": "node scripts/generate-performance-assets.mjs tests/output/performance-assets",
    "test:validation": "npm run generate:validation && node --test tests/validation-assets.test.mjs",
    "audit:prod": "npm audit --audit-level=moderate",
    "test:xlsx": "node --test tests/xlsx-core.test.mjs",
    "test:xlsx-package": "node --test tests/xlsx-package.test.mjs",
    "test:csv": "node --test tests/csv-core.test.mjs",
    "test:fixtures": "node --test tests/multi-fixture-roundtrip.test.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "test:office": "node --test tests/office-openxml.test.mjs",
    "test:html": "node --test tests/html-core.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "dompurify": "3.4.14",
    "exceljs": "4.4.0",
    "jszip": "3.10.1",
    "pg": "8.16.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "docx": "^9.7.1",
    "jsdom": "^30.0.1"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
